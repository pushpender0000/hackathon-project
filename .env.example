# Google Gemini Configuration
# Provide your Google Gemini API key from Google AI Studio
GEMINI_API_KEY=
# Set accessible model (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6-flash
# Thinking Governance:
# For Gemini 3.x (e.g. gemini-3.6-flash): use GEMINI_THINKING_LEVEL (minimal, low, medium, high)
GEMINI_THINKING_LEVEL=minimal
# For Gemini 2.x (e.g. gemini-2.0-flash, gemini-2.5-flash): use GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_BUDGET=0

# Hard Output Token Ceilings (per generation request)
GEMINI_CLASSIFIER_MAX_OUTPUT_TOKENS=300
GEMINI_SYNTHESIS_MAX_OUTPUT_TOKENS=500
GEMINI_JUDGE_MAX_OUTPUT_TOKENS=350

# Local Safety Token Budget Ceilings
GEMINI_MAX_CUMULATIVE_TOKENS=30000

# Local Storage Paths
SQLITE_DB_PATH=data/memory/checkpoints.sqlite
LONG_TERM_STORE_PATH=data/memory/long_term_store.sqlite
CHROMA_PERSIST_DIR=data/chroma_db
POLICY_CORPUS_DIR=data/policy_corpus
